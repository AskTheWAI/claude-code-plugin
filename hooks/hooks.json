{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && npx -y --package @askthew/mcp-plugin@0.7.0 askthew-mcp session-start",
            "statusMessage": "Ask The W paid ready",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ]
  }
}
